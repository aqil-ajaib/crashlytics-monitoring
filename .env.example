# Slack app credentials (Socket Mode)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Optional: restrict the bot to a single channel ID (recommended).
# Right-click the channel in Slack -> View channel details -> copy the Channel ID.
CRASH_CHANNEL_ID=C0123456789

# GitHub access to read CODEOWNERS and the repo file tree.
# Needs "Contents: Read" (fine-grained PAT) or "repo" scope (classic PAT) on the target repo.
GITHUB_TOKEN=ghp_your_token
GITHUB_OWNER=your-org
GITHUB_REPO=your-android-repo
# Optional, defaults to the repo's default branch
GITHUB_BRANCH=master
# Optional, defaults to .github/CODEOWNERS
CODEOWNERS_PATH=.github/CODEOWNERS

# Optional, defaults to config/owners-map.json
OWNERS_MAP_PATH=config/owners-map.json
